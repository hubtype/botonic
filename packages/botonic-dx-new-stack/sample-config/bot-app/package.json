{
  "name": "my-bot-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "ENVIRONMENT=production NODE_ENV=production rspack build --env target=all --mode=production",
    "start": "ENVIRONMENT=local NODE_ENV=development rspack serve --env target=dev --mode=development",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "vitest run --coverage",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@botonic/react": "0.57.0-rslib-esm.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@botonic/dx-new-stack": "0.57.0-rslib-esm.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  }
}
