{
  "name": "@botonic/dx-new-stack",
  "version": "0.57.0-rslib-esm.2",
  "type": "module",
  "description": "Shared Rslib, Vitest, Biome and TypeScript configuration for Botonic libraries",
  "license": "MIT",
  "exports": {
    "./biome": "./baseline/biome.json",
    "./baseline/biome.json": "./baseline/biome.json",
    "./baseline/tsconfig.json": "./baseline/tsconfig.json",
    "./baseline/tsconfig.build.json": "./baseline/tsconfig.build.json",
    "./baseline/tsconfig.tests.json": "./baseline/tsconfig.tests.json",
    "./baseline/tests/tsconfig.json": "./baseline/tests/tsconfig.json",
    "./baseline/rslib.config": "./baseline/rslib.config.mts",
    "./baseline/vitest.config": {
      "types": "./baseline/vitest.config.d.mts",
      "default": "./baseline/vitest.config.mjs"
    }
  },
  "files": [
    "README.md",
    "baseline/**",
    "sample-config/**"
  ],
  "scripts": {
    "build": "node -e \"console.log('Configuration package: no compilation required')\"",
    "lint": "biome check --write baseline/",
    "lint:check": "biome check baseline/",
    "format": "biome format --write baseline/"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.13",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "1.0.0",
    "@types/node": "^20.17.14",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "identity-obj-proxy": "3.0.0",
    "jsdom": "26.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  }
}
