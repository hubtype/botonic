{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "module": "NodeNext",
    "rootDir": ".",
    "strict": false,
    "target": "es2022",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "isolatedModules": true,
    "composite": false,
    "noEmit": true
  },
  "include": [
    "./src/**/*",
    "./src/types/**/*",
    "./tests/**/*",
    "./vitest.setup.ts",
    "./vitest.config.ts"
  ],
  "exclude": ["templates", "dist", "lib"],
  "ts-node": {
    "esm": true
  }
}
