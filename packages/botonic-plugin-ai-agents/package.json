{
  "name": "@botonic/plugin-ai-agents",
  "version": "0.55.0",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "description": "Use AI Agents to generate your contents",
  "scripts": {
    "build": "node ../../scripts/build/clean.mjs && rslib build --no-env",
    "build:watch": "node ../../scripts/build/clean.mjs && rslib build --watch --no-env",
    "test": "../../node_modules/.bin/jest --coverage",
    "prepublishOnly": "npm run build",
    "lint": "biome check --write src/ tests/",
    "lint:check": "biome check src/ tests/",
    "format": "biome format --write src/ tests/"
  },
  "dependencies": {
    "@botonic/core": "^0.55.0",
    "@openai/agents": "^0.10.1",
    "axios": "^1.18.1",
    "openai": "^6.36.0",
    "uuid": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0"
  },
  "files": [
    "lib/**",
    "src/**",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hubtype/botonic.git"
  },
  "keywords": [
    "bot-framework",
    "chatbot",
    "ai-agents",
    "conversational-app",
    "typescript",
    "javascript"
  ],
  "author": "",
  "types": "./lib/esm/index.d.ts"
}
