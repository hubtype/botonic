{
  "name": "@botonic/core",
  "version": "0.55.1",
  "license": "MIT",
  "description": "Build Chatbots using React",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "default": "./lib/esm/index.js"
    },
    "./testing": {
      "types": "./lib/esm/testing/index.d.ts",
      "default": "./lib/esm/testing/index.js"
    }
  },
  "scripts": {
    "test": "../../node_modules/.bin/jest --coverage",
    "prepublishOnly": "npm run build",
    "lint": "biome check --write src/",
    "lint:check": "biome check src/",
    "format": "biome format --write src/",
    "build": "node ../../scripts/build/clean.mjs && rslib build --no-env",
    "build:watch": "node ../../scripts/build/clean.mjs && rslib build --watch --no-env",
    "cloc": "../../scripts/qa/cloc-package.sh ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hubtype/botonic.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/hubtype/botonic/issues"
  },
  "files": [
    "src/**",
    "lib/**",
    "index.d.ts",
    "README.md"
  ],
  "typesVersions": {
    "*": {
      "testing": [
        "./lib/esm/testing/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "@babel/plugin-transform-runtime": "^7.25.9",
    "axios": "^1.18.1",
    "pako": "^2.1.0",
    "process": "^0.11.10",
    "pusher-js": "^5.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pako": "^1.0.2",
    "babel-plugin-add-module-exports": "^1.0.2"
  },
  "homepage": "https://github.com/hubtype/botonic#readme",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "bot-framework",
    "chatbot",
    "conversational-app",
    "conversational-ui",
    "javascript"
  ],
  "sideEffects": false,
  "types": "./lib/esm/index.d.ts"
}
