{
  "type": "module",
  "name": "@botonic/plugin-flow-builder",
  "version": "0.57.0-rslib-esm.1",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "description": "Use Flow Builder to show your contents",
  "scripts": {
    "build": "rslib build --no-env",
    "build:watch": "rslib build --watch --no-env",
