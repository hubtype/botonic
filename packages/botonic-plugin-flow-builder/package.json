    "url": "git+https://github.com/hubtype/botonic.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/hubtype/botonic/issues"
  },
  "files": [
    "lib/**",
    "src/**",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "bot-framework",
    "chatbot",
    "flow-builder",
    "conversational-app",
    "conversational-ui",
    "javascript"
  ],
