{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {},
    "rootDir": "src",
    "outDir": "lib",
    "composite": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "noEmit": false,
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": ["tests", "lib"]
}
